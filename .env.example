# ProgramSmith env reference — copy to a gitignored .env and fill in what you need.
# Everything runs locally: Docker sandbox trials billed to YOUR OWN provider keys.
# NEVER commit real secrets.

# ---- model credentials (BYO keys) ----------------------------------------------------------------
# One Anthropic credential path is REQUIRED (the pipeline's cells + the claude-code solver ride it).
# Precedence: CLAUDE_CODE_OAUTH_TOKEN > ANTHROPIC_API_KEY > the `claude` CLI's own keychain login.
CLAUDE_CODE_OAUTH_TOKEN=                # from `claude setup-token` (subscription billing)
ANTHROPIC_API_KEY=                      # sk-ant-... (API billing)
OPENAI_API_KEY=                         # OPTIONAL — enables the codex + mini-swe/openai families
GEMINI_API_KEY=                         # OPTIONAL — enables the gemini-cli + mini-swe/gemini families
ZAI_API_KEY=                            # OPTIONAL — enables GLM models through mini-swe

# ---- control plane / paths -----------------------------------------------------------------------
PROGRAMSMITH_RUNS_DIR=.programsmith/runs                 # per-run state dir (set by `programsmith serve --runs-dir`)
PROGRAMSMITH_CONFIG_PATH=.programsmith/config.json       # persisted config file
# Advanced: override the STATIC_CI check suite (the bundled checks are used by default):
#PROGRAMSMITH_CI_REPO_ROOT=/path/to/custom/check-suite

# ---- fleet auto-driver (`serve` enables task generation but keeps evaluation sweeps off by default) --------
PROGRAMSMITH_AUTODRIVE=1                          # run the fleet driver loop in the serve process
PROGRAMSMITH_AUTODRIVE_SPEND=0                    # set to 1, or pass --spend, to authorize billable sweeps
PROGRAMSMITH_AGENTIC=1                            # allow agentic claude -p cells to launch
PROGRAMSMITH_AUTODRIVE_INTERVAL=8                 # driver pass interval (seconds)

# ---- trial tuning --------------------------------------------------------------------------------
#PROGRAMSMITH_TRIAL_COST_LIMIT=0                  # per-trial $ cap for mini-swe solves (0 = uncapped)

# ---- ingest tuning -------------------------------------------------------------------------------
#PROGRAMSMITH_GIT_TIMEOUT=120                     # git metadata ops timeout (seconds)
#PROGRAMSMITH_CLONE_TIMEOUT=300                   # treeless-clone timeout — one slow repo never stalls a farm
